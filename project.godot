; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Node",
"class": "DlxmetadatamanagerAPI",
"language": "GDScript",
"path": "res://DlxmetadatamanagerAPI.gd"
}, {
"base": "Node",
"class": "GraphProcessing",
"language": "GDScript",
"path": "res://GraphProcessing.gd"
} ]
_global_script_class_icons={
"DlxmetadatamanagerAPI": "",
"GraphProcessing": ""
}

[application]

config/name="dlxmetadatamanager-visual"
run/main_scene="res://main.tscn"
boot_splash/image="res://splashscreen.PNG"
boot_splash/bg_color=Color( 0.188235, 0.25098, 0.301961, 1 )
config/icon="res://icon.png"

[display]

window/size/width=1920
window/size/height=1080
window/dpi/allow_hidpi=true

[rendering]

quality/driver/fallback_to_gles2=true
quality/2d/gles2_use_nvidia_rect_flicker_workaround=true
quality/subsurface_scattering/quality=2
environment/default_clear_color=Color( 0.188235, 0.25098, 0.301961, 1 )
quality/depth/hdr=false
environment/default_environment="res://default_env.tres"
